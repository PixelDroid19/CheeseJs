{
  "name": "cheesejs",
  "private": true,
  "version": "1.1.0",
  "productName": "CheeseJS",
  "author": "Damien Monasterios <monasterio13septiembre@gmail.com>",
  "repository": "github:PixelDroid19/CheeseJs",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm run native:dev",
    "dev:vite": "node scripts/dev-vite.mjs",
    "dev:web": "node scripts/dev-vite.mjs",
    "native:check": "node scripts/check-native-prereqs.mjs",
    "native:cef": "pnpm exec zero-native cef install --dir third_party/cef/macos",
    "native:dev": "pnpm run native:check && zig build dev -Dweb-engine=system --cache-dir /tmp/cheesejs-zig-cache --global-cache-dir /tmp/cheesejs-zig-global-cache",
    "native:run": "pnpm run native:check && zig build run -Dweb-engine=system --cache-dir /tmp/cheesejs-zig-cache --global-cache-dir /tmp/cheesejs-zig-global-cache",
    "native:test": "zig build test -Dplatform=null --cache-dir /tmp/cheesejs-zig-cache --global-cache-dir /tmp/cheesejs-zig-global-cache",
    "native:validate": "pnpm exec zero-native validate app.zon",
    "native:doctor": "pnpm exec zero-native doctor --manifest app.zon",
    "native:package": "node scripts/package-native.mjs",
    "native:package:check": "node scripts/check-native-package.mjs",
    "native:build:windows": "zig build -Dtarget=x86_64-windows-gnu -Dplatform=windows -Dweb-engine=system --cache-dir /tmp/cheesejs-zig-cache --global-cache-dir /tmp/cheesejs-zig-global-cache",
    "native:package:windows": "pnpm run build:frontend && pnpm run native:build:windows && node scripts/package-native.mjs --target windows && node scripts/check-native-package.mjs windows",
    "package:native": "pnpm run build && pnpm run native:package",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "build:vite": "node --max-old-space-size=6144 ./node_modules/vite/bin/vite.js build",
    "build:frontend": "pnpm run build:vite",
    "build": "pnpm run native:check && pnpm run build:frontend && zig build -Dweb-engine=system -Doptimize=ReleaseFast --cache-dir /tmp/cheesejs-zig-cache --global-cache-dir /tmp/cheesejs-zig-global-cache",
    "build:dist": "pnpm run build:vite",
    "lint": "eslint packages scripts --report-unused-disable-directives --max-warnings 0",
    "arch:check": "node scripts/check-architecture.mjs",
    "lint:fix": "eslint packages scripts --fix",
    "format": "prettier --write \"packages/**/*.{ts,tsx,js,jsx,json,css,md}\" \"scripts/**/*.mjs\" \"*.{json,html,ts}\" \"readme*.md\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,js,jsx,json,css,md}\" \"scripts/**/*.mjs\" \"*.{json,html,ts}\" \"readme*.md\"",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:workers": "pnpm run native:test",
    "test:ui": "vitest --ui",
    "bench": "vitest bench",
    "quality": "pnpm run native:check && pnpm run native:validate && pnpm run native:doctor && pnpm run lint && pnpm run arch:check && pnpm run format:check && pnpm run type-check && pnpm run test:coverage && pnpm run native:test",
    "release:check": "pnpm run quality && pnpm run package:native && pnpm run native:package:check && pnpm run native:package:windows && pnpm run bundle:check && pnpm exec playwright test",
    "ci:platforms:check": "node scripts/check-ci-platforms.mjs",
    "audit": "pnpm audit",
    "audit:fix": "pnpm audit --fix",
    "prerelease": "pnpm run quality && pnpm run audit",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@fontsource/courier-prime": "^5.2.8",
    "@fontsource/patrick-hand": "^5.2.8",
    "@lezer/common": "^1.5.2",
    "@lezer/javascript": "^1.5.4",
    "@lezer/python": "^1.1.18",
    "@swc/core": "^1.15.11",
    "@vscode/vscode-languagedetection": "^1.0.23",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "dotenv-expand": "^12.0.3",
    "framer-motion": "^12.34.3",
    "i18next": "^25.8.13",
    "i18next-browser-languagedetector": "^8.2.1",
    "idb-keyval": "^6.2.2",
    "json-cycle": "^1.5.0",
    "lucide-react": "^0.575.0",
    "monaco-languageclient": "^10.7.0",
    "path-browserify": "^1.0.1",
    "pyodide": "^0.29.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.4",
    "react-split": "2.0.14",
    "rollup": "^4.59.0",
    "stringify-object": "^6.0.0",
    "tailwind-merge": "^3.5.0",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageclient": "^9.0.1",
    "vscode-ws-jsonrpc": "^3.5.0",
    "ws": "^8.19.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/generator": "^7.29.7",
    "@babel/parser": "^7.29.7",
    "@babel/plugin-syntax-unicode-sets-regex": "^7.18.6",
    "@babel/traverse": "^7.29.7",
    "@babel/types": "^7.29.7",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@eslint/js": "^10.0.1",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/babel__standalone": "^7.1.9",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "autoprefixer": "^10.5.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.4.1",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-security": "^4.0.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.2.7",
    "monaco-editor": "^0.55.1",
    "playwright": "^1.60.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "pyright": "^1.1.410",
    "sass": "^1.100.0",
    "standard": "^17.1.2",
    "tailwindcss": "^4.3.0",
    "typescript-language-server": "^5.3.0",
    "vite": "^7.3.1",
    "zero-native": "^0.2.0",
    "vitest": "^4.1.8"
  },
  "type": "module",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.30.0+sha512.2b5753de015d480eeb88f5b5b61e0051f05b4301808a82ec8b840c9d2adf7748eb352c83f5c1593ca703ff1017295bc3fdd3119abb9686efc96b9fcb18200937"
}
